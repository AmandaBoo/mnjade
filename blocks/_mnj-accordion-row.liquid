{% doc %}
  Renders one expandable row of the MN JADE product accordion with native details and summary, for
  the product in context. Its text is either its own text setting or, with source set to the
  description's bullet list, the first bulleted list in the product description (the spec bullets),
  which the stylesheet then hides in the description itself. The row only renders when the product's
  Type is one of its product types (or none are set), its description passes the contains and
  excludes checks (all compared in lowercase) and it has text. In the theme editor without a
  product, every row with its own text shows.

  @example
  {% content_for 'block', type: '_mnj-accordion-row', id: 'care' %}
{% enddoc %}

{% liquid
  assign product = closest.product
  assign show_row = true

  if product != blank
    assign product_type = product.type | downcase | strip
    assign description = product.description | strip_html | downcase

    if block.settings.product_types != blank
      assign show_row = false
      assign types = block.settings.product_types | downcase | split: ','
      for type in types
        assign wanted = type | strip
        if wanted == product_type
          assign show_row = true
        endif
      endfor
    endif

    if block.settings.description_contains != blank
      assign needle = block.settings.description_contains | downcase | strip
      unless description contains needle
        assign show_row = false
      endunless
    endif

    if block.settings.description_excludes != blank
      assign needle = block.settings.description_excludes | downcase | strip
      if description contains needle
        assign show_row = false
      endif
    endif
  endif

  assign row_text = block.settings.text
  if block.settings.source == 'description_list'
    assign row_text = ''
    if product.description contains '<ul'
      assign list_body = product.description | split: '<ul' | slice: 1, 1 | first | split: '</ul>' | first
      assign row_text = '<ul' | append: list_body | append: '</ul>'
    endif
  endif

  if block.settings.heading == blank or row_text == blank
    assign show_row = false
  endif
%}

{% if show_row %}
  <details
    class="mnj-accordion-row{% if block.settings.source == 'description_list' %} mnj-accordion-row--description-list{% endif %}"
    {{ block.shopify_attributes }}
  >
    <summary class="mnj-accordion-row__summary">
      {%- if block.settings.icon != 'none' -%}
        <svg
          class="mnj-accordion-row__icon"
          aria-hidden="true"
          focusable="false"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 20 20"
        >
          {%- render 'icon', icon: block.settings.icon -%}
        </svg>
      {%- endif -%}
      <span class="mnj-accordion-row__heading">{{ block.settings.heading | escape }}</span>
      <span class="svg-wrapper mnj-accordion-row__caret" aria-hidden="true">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
    </summary>
    <div class="mnj-accordion-row__content rte">
      {{ row_text }}
    </div>
  </details>
{% endif %}

{% stylesheet %}
  .mnj-accordion-row {
    border-block-end: 1px solid var(--color-border);
  }

  .mnj-accordion-row__summary {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
  }

  .mnj-accordion-row__summary::-webkit-details-marker {
    display: none;
  }

  .mnj-accordion-row__icon {
    flex: none;
  }

  .mnj-accordion-row__heading {
    flex: 1 1 auto;
    min-width: 0;
  }

  .mnj-accordion-row__caret {
    flex: none;
    width: 12px;
    transition: transform var(--animation-speed) var(--animation-easing);
  }

  .mnj-accordion-row[open] .mnj-accordion-row__caret {
    transform: rotate(180deg);
  }

  .mnj-accordion-row__content {
    padding-block-end: 20px;
    overflow-wrap: anywhere;
  }

  @media (prefers-reduced-motion: reduce) {
    .mnj-accordion-row__caret {
      transition: none;
    }
  }
{% endstylesheet %}

